#!/bin/bash
# 统一入口：在 ChatGPT Pro / Claude Pro / Kimi 之间动态切换。
# 所有请求都走本地 claude-code-proxy，启动后可在 Claude Code 内 /model 切换。

PROXY_PORT="${CCP_PORT:-18765}"
PROXY_PID_FILE="/tmp/claude-code-proxy.pid"
PROXY_LOG="/tmp/claude-code-proxy.log"
# 默认假设 wrapper 放在 repo 的 scripts/ 下；可用 CCP_SRC 覆盖
if [ -n "$CCP_SRC" ]; then
  PROXY_SRC="$CCP_SRC"
else
  PROXY_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# 默认 GPT 模式 —— /model picker 会自动多出 gpt-5.5 一行（Claude Code 把 ANTHROPIC_MODEL 显示为 Custom model）
# 然后用户可在 picker 里 5 个 Claude 家族 + gpt-5.5 之间任意切换
DEFAULT_MODEL="gpt-5.5"
DEFAULT_FAST_MODEL="gpt-5.4-mini"
MODE_LABEL="ChatGPT Pro (默认 — picker 含 gpt-5.5 + Claude 家族)"
EXTRA_MODEL=""
EXTRA_MODEL_NAME=""
EXTRA_MODEL_DESC=""
EXTRA_MODEL_CAPS=""

case "${1:-}" in
  gpt|api)
    DEFAULT_MODEL="gpt-5.5"
    DEFAULT_FAST_MODEL="gpt-5.4-mini"
    MODE_LABEL="ChatGPT Pro"
    shift
    ;;
  claude|pro)
    DEFAULT_MODEL="claude-opus-4-7"
    DEFAULT_FAST_MODEL="claude-haiku-4-5"
    MODE_LABEL="Claude Pro"
    # 试图让 picker 同时显示 gpt-5.5（实验性 — 取决于 Claude Code 是否吃这组 env）
    EXTRA_MODEL="gpt-5.5"
    EXTRA_MODEL_NAME="ChatGPT 5.5"
    EXTRA_MODEL_DESC="Switch to ChatGPT Pro via codex provider"
    EXTRA_MODEL_CAPS="opus"
    shift
    ;;
  kimi)
    DEFAULT_MODEL="kimi-for-coding"
    DEFAULT_FAST_MODEL="kimi-for-coding"
    MODE_LABEL="Kimi"
    shift
    ;;
  -h|--help)
    cat <<'EOF'
用法:
  claude-gpt [模式] [claude 参数...]

启动模式（决定默认 model；启动后可在 Claude Code 里用 /model 自由切换）:
  claude | pro    Claude Pro，默认 claude-opus-4-7（默认）
  gpt | api       ChatGPT Pro，默认 gpt-5.5
  kimi            Kimi K2.6

启动后在 Claude Code 内可切换的模型:
  /model claude-opus-4-7
  /model claude-sonnet-4-6
  /model claude-sonnet-4-5
  /model claude-haiku-4-5
  /model gpt-5.5
  /model gpt-5.4
  /model gpt-5.4-mini
  /model kimi-for-coding

子命令:
  claude-gpt stop      停止后台代理进程
  claude-gpt status    查看代理状态
  claude-gpt -h        显示此帮助
EOF
    exit 0
    ;;
  stop)
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
      kill "$(cat "$PROXY_PID_FILE")"
      rm -f "$PROXY_PID_FILE"
      echo "[claude-gpt] 代理已停止"
    else
      echo "[claude-gpt] 代理未运行"
    fi
    exit 0
    ;;
  status)
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
      echo "[claude-gpt] 代理运行中 (PID $(cat "$PROXY_PID_FILE"), port $PROXY_PORT)"
      echo "[claude-gpt] 日志: $PROXY_LOG"
    else
      echo "[claude-gpt] 代理未运行"
    fi
    exit 0
    ;;
esac

# 启动本地源码版 proxy（支持 anthropic provider，含 claude-sonnet-4-5 修复）
if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
  echo "[claude-gpt] 代理已运行 (PID $(cat "$PROXY_PID_FILE"))"
else
  echo "[claude-gpt] 启动本地修改版代理 (anthropic + codex + kimi)..."
  cd "$PROXY_SRC" && bun run src/cli.ts serve > "$PROXY_LOG" 2>&1 &
  echo $! > "$PROXY_PID_FILE"
  sleep 1.5
  if kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
    echo "[claude-gpt] 代理已启动 (PID $(cat "$PROXY_PID_FILE"), port $PROXY_PORT)"
  else
    echo "[claude-gpt] ❌ 代理启动失败，查看日志: $PROXY_LOG"
    rm -f "$PROXY_PID_FILE"
    exit 1
  fi
fi

export ANTHROPIC_BASE_URL="http://localhost:${PROXY_PORT}"
export ANTHROPIC_AUTH_TOKEN="proxy"
export ANTHROPIC_MODEL="$DEFAULT_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$DEFAULT_FAST_MODEL"
export CCP_CODEX_EFFORT="max"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

# 让 /model picker 多一行可切换的 model（跨 provider 切换的关键）
# 注意：4 个 env var 必须都设，缺一不可（Claude Code v2.1.137 实测）
if [ -n "$EXTRA_MODEL" ]; then
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$EXTRA_MODEL"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$EXTRA_MODEL_NAME"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="$EXTRA_MODEL_DESC"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES="${EXTRA_MODEL_CAPS:-opus}"
fi

echo "[claude-gpt] 启动模式: $MODE_LABEL"
echo "[claude-gpt] 默认模型: $DEFAULT_MODEL"
if [ -n "$EXTRA_MODEL" ]; then
  echo "[claude-gpt] /model 额外可选: $EXTRA_MODEL ($EXTRA_MODEL_NAME)"
fi
echo "[claude-gpt] 在 Claude Code 内输入 /model 切换"
echo ""

exec claude --effort high "$@"
